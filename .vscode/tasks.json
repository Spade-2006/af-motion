{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build AF Motion",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Run Tests",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Start MCP Stdio Server",
      "type": "shell",
      "command": "node bin/mcp-server.js",
      "problemMatcher": []
    }
  ]
}
